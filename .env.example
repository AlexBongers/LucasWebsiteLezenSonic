# Stemgenerator. Kies er één (zie content/stem.json bij "provider").
# In een Claude-cloudomgeving: zet deze als omgevingsvariabele in de omgevingsinstellingen (niet in de chat plakken).

# Google Cloud Text-to-Speech (aanbevolen): console.cloud.google.com → Text-to-Speech API aanzetten → API-sleutel
GOOGLE_TTS_API_KEY=

# ElevenLabs: https://elevenlabs.io → Profiel → API keys
ELEVENLABS_API_KEY=

# Microsoft Azure AI Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
